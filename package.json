{
  "name": "vamper",
  "version": "0.1.0",
  "description": "A film-score looper for game masters. Installable browser app using your own music files.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src/index.ts",
    "src/engine",
    "src/analysis",
    "src/score",
    "src/audio",
    "LICENSE",
    "README.md",
    "docs/ENGINE.md",
    "public/models",
    "licenses"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc && tsc -p tsconfig.lib.json",
    "make-tracks": "node tools/make-test-tracks.mjs",
    "test": "node tools/join-test.mjs",
    "preview": "node tools/artifact.mjs",
    "deploy": "npm run build && npx wrangler deploy"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@mediapipe/tasks-audio": "1.0.1"
  }
}
